    },
    {
      "id": "claim_7c86bfaa5fcb473b8b9596c83b2fc751",
      "statement": "Dependencies are declared by jar file name rather than by a build file: buildLibClasspath lists the *.jar files of web/WEB-INF/lib, sorts them and produces the javac -cp value, so dropping a jar into that directory is what adds a dependency to both compilation and the runtime webapp classloader.",
      "evidence": [
        {
          "resource": "repo://src/StartJetty.java#L169-L169",
          "version": "repo-lines-v1:sha256:cc796bae4f4594216a9de49eb1509b5f51ee99163f7806da5ac649cbb586af29:"
        },
        {
          "resource": "repo://src/StartJetty.java#L208-L213",
