        }
      ]
    },
    {
      "id": "claim_d47cf11d2ea741ae92a7fbe6bc8f6fea",
      "statement": "openJdk9PlusModules runs as the first statement of main and is a reflective equivalent of --add-opens for nine java.base packages; it is a silent no-op on JDK 8, and on JDK 9+ each addOpens call is individually wrapped so a failure is invisible, leaving a framework stack trace as the only diagnostic.",
      "evidence": [
        {
          "resource": "repo://src/StartJetty.java#L215-L236",
          "version": "repo-lines-v1:sha256:cc7839c64c41970a7ff30dc4c0ef4e28313257b1820104ec835aff3e3126401f:"
