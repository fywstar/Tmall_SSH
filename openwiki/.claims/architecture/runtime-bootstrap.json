    {
      "id": "claim_0c888e7db7d441a7a5d335e6a43fd5d8",
      "statement": "server.setStopAtShutdown(true) gives the launcher an orderly shutdown on JVM exit, and server.join() is its final statement: there is no watchdog, hot reload or explicit System.exit in the launcher.",
      "evidence": [
        {
          "resource": "repo://src/StartJetty.java#L105-L105",
          "version": "repo-lines-v1:sha256:0a1889d9e76d5734b1b29c9c9a6048c52788d7fa7003deed42ba96fa05ad4181:"
