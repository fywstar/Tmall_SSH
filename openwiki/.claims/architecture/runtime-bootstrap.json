          "version": "repo-lines-v1:sha256:299a62f60b2f514abd117c62303a8cad842fe306c3a7e25ae84239abf7942d25:"
        }
      ]
    },
    {
      "id": "claim_41d29f109c7d4a739e21ab90b13c6bcf",
      "statement": "The launcher fixes the deployment values as compile-time constants PORT = 8080, H2_CONSOLE_PORT = 8082 and CONTEXT_PATH = \"/\"; no container or Spring/Struts configuration file can override them, so changing a port or the context path is a Java edit plus a restart, and the printed banner and STARTUP.md repeat the same three addresses.",
      "evidence": [
        {
          "resource": "repo://STARTUP.md#L42-L49",
          "version": "repo-lines-v1:sha256:8b3021976d683f231696aa4c219633aae9f7cccc82713e5698863025460dc79b:"
        },
