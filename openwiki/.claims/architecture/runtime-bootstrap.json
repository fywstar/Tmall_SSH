  "claims": [
    {
      "id": "claim_5c95470ac92a4b6599f04dd0fad9d5d1",
      "statement": "src/StartJetty.java is the repository's single entry point: its main method is a business-independent launcher that compiles src, deploys the original web/ directory into embedded Jetty on port 8080 and starts an H2 console on a second port, which is why the original web.xml, JSPs and business Java sources stay unmodified.",
      "evidence": [
        {
          "resource": "repo://MIGRATION.md#L17-L17",
          "version": "repo-lines-v1:sha256:776a15dc129effaea4f931953ccaaef64ee02cf737924055238da6f3df99dce4:"
        },
        {
          "resource": "repo://MIGRATION.md#L3-L11",
          "version": "repo-lines-v1:sha256:8da5d8fcf96a254ae22f3c58b1038db7b9154e4b1b5f7264123c0da661c63761:"
        },
        {
