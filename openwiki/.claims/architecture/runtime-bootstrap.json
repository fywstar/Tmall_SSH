    {
      "id": "claim_4af3107c3c194acda8f72bacfdb014ff",
      "statement": "The H2 console is a second, independent server created on port 8082 and started before Jetty, because the Struts2 filter mapped to /* in web.xml would intercept an in-app console path and answer with no action mapped; the launcher keeps no reference to that server object and starts it fire-and-forget.",
      "evidence": [
        {
          "resource": "repo://STARTUP.md#L68-L68",
          "version": "repo-lines-v1:sha256:5c1aa8a80f0348af20f415b89be05ae0a82737ffa93c65a068201e6161ac95c6:"
