    {
      "id": "claim_e66e7da5e7214f72a09bc73dd773f2cd",
      "statement": "StartJetty compiles every .java file under src/ into web/WEB-INF/classes (UTF-8, -source/-target 8, classpath built from all jars in web/WEB-INF/lib) and copies non-Java resources on every launch, so there is no separate build step, web/WEB-INF/classes is disposable generated output, and a compile failure aborts startup before any port is bound.",
      "evidence": [
        {
          "resource": "repo://MIGRATION.md#L28-L35",
          "version": "repo-lines-v1:sha256:5ab3cc898d187357841413afb3cd61b585d6c9d5133a10ed6b51d645772d7d85:"
