    {
      "id": "claim_2532151895ab4e2e90d7d29c915a9104",
      "statement": "The whole application is started by one entry point, StartJetty.main(), runnable either from an IDE with the working directory set to the project root or as `java -cp \"web/WEB-INF/lib/*\" src/StartJetty.java`; nothing beyond a JDK (8, 11 or 17) needs to be installed because embedded Jetty 9.4.58 and H2 1.4.200 are vendored in web/WEB-INF/lib.",
      "evidence": [
        {
          "resource": "repo://STARTUP.md#L5-L40",
          "version": "repo-lines-v1:sha256:9a40e5a44491ca8f67b6952931e262691c69087378452ebda0658e0cced3010c:"
