    },
    {
      "id": "claim_41e2e9bc355649b2b1065673916c6035",
      "statement": "A successful start exposes exactly three operational URLs bound to fixed port constants 8080 and 8082: the storefront at http://localhost:8080/ (the launcher rewrites the exact path / to /forehome), the back office at http://localhost:8080/admin_category_list, and the H2 web console at http://localhost:8082; the console uses a separate port because the Struts2 filter mapped to /* in web.xml would intercept an in-app console path as an unmapped action.",
      "evidence": [
        {
          "resource": "repo://STARTUP.md#L42-L49",
